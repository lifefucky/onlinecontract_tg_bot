# Скопируйте в .env или выполните: export $(grep -v '^#' .env | xargs)
# Токен бота от @BotFather (не коммитьте реальное значение)

TOKEN=

# Журнал пользователей и треки сообщений. Без файловой базы учёт пропадёт при перезапуске.
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Как часто присылать файл базы владельцам из ADMIN_IDS, в часах. По умолчанию 24.
# DB_BACKUP_INTERVAL_HOURS=24

# Слать файл при старте процесса, если интервал уже вышел. По умолчанию 0:
# старт не присылает копию, а ждёт DB_BACKUP_INTERVAL_HOURS.
# DB_BACKUP_ON_START=0

# Как часто проверять конкурсные листы, в минутах. По умолчанию 15.
# Новые id и листы со сменой прайса или правил. «Подходит» уходит всем, кто нажал /start
# и не закрыт, и id из ADMIN_IDS. «Пограничный» — только владельцам.
# MATCH_POLL_INTERVAL_MINUTES=15

# Файл прайса (.xls). Абсолютный путь или путь от корня репозитория.
# Пустое значение: /price записывает data/price-list.xls.
# Если путь задан, /price перезаписывает этот файл.
# Перед заменой прежний файл копируется в data/price-list.prev.xls.
# Пока своего файла ещё нет, пустое значение берёт самый большой .xls в data/
# (сначала с «ОПТ» в имени), затем устаревший docs/research.
# PRICE_LIST_PATH=

# Ключ эмбеддингов ProxyAPI (совместим с OpenAI). Источник — корневой .env.
# docs/research/.env — устаревшее дополнение: читается только если файл есть и переменной ещё нет.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.proxyapi.ru/v1

# Полный расчёт эмбеддингов прайса (~13 тысяч позиций) сам не запускается.
# Один раз из корня репозитория:
# MATCH_ALLOW_CATALOG_EMBED=1 python -m matching.run --embed-catalog
# MATCH_ALLOW_CATALOG_EMBED=

# Категории прайса, которые не считать интересными, через запятую. Пусто — все включены.
# MATCH_DISABLED_CATEGORIES=

# Числовые Telegram user id владельцев через запятую.
# Команды: /stats /users /user /ban /unban /reset /delete_user /price
# Узнать id: @userinfobot
# ADMIN_IDS=
